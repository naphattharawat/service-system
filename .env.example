# Google service account (Sheets API access — NOT used for Drive, see below).
# Share both spreadsheets with this account's client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the service account JSON key. Keep the \n escape sequences literal.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Calendar API key (read-only), used to check the public Thai public-holiday calendar.
GOOGLE_CALENDAR_API_KEY=

# Drive uploads authenticate as a real Google account (OAuth), not the
# service account above — bare service accounts have zero Drive storage
# quota, so on a personal Gmail account (no Shared Drives, no domain-wide
# delegation) they can't own any uploaded file.
# 1. Cloud Console -> APIs & Services -> Credentials -> Create Credentials ->
#    OAuth client ID -> Application type "Desktop app". Copy its ID/secret below.
# 2. Run: node scripts/get-drive-refresh-token.mjs
#    and paste the refresh token it prints into GOOGLE_OAUTH_REFRESH_TOKEN.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Sheet1: job requests, users, login log, settings.
SHEET1_ID=10Z9H15ca5gmaVcR9y-B_niYhtYxZiU_x7uzXGZEGwOc
SHEET1_NAME=การตอบแบบฟอร์ม 1
USERS_SHEET_NAME=users
