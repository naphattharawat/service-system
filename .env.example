# Drive folder that job attachments get uploaded into (one subfolder per job id).
DRIVE_FOLDER_ID=1pKkFnghu8Fq3l8lPa0aq3pNDRsrbT-uSQnt7Zgbaqfpgcv00A5kkR_xb8_dXRlgb8Kfs30OM

# Session cookie encryption secret — must be at least 32 characters. Generate with e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# MOPH LINE notify gateway — sends a message when a new service request comes in.
LINE_NOTIFY_URL=https://morpromt2f.moph.go.th/api/notify/send
LINE_NOTIFY_CLIENT_KEY=
LINE_NOTIFY_SECRET_KEY=
